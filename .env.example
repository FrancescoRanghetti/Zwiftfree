# Copy to .env and adjust. Never commit .env.
DB_NAME=zwiftfree
DB_USER=zwiftfree
DB_PASSWORD=change-me

# HMAC key for access tokens, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Host ports (container ports are fixed)
DB_HOST_PORT=5442
BACKEND_HOST_PORT=8090
FRONTEND_HOST_PORT=4280

# Origins allowed to call the API directly (through nginx the app is same-origin anyway)
CORS_ALLOWED_ORIGINS=http://localhost:4280,http://localhost:4200
